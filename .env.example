ELITE3_HANDLES=@min_anko38,@LNCV34,@Alisvolatprop12
ALLOW_PAID_PROVIDERS=false
COST_SOFT_ALERT_KRW=300000
COST_HARD_STOP_KRW=500000
KRW_PER_USD=1500

# Optional free-tier / owned resources. Leave blank for local fixture mode.
DATABASE_URL=
TELEGRAM_BOT_TOKEN=
TRIAGE_CHAT_ID=
INTERNALIZATION_BOT_TOKEN=
INTERNALIZATION_CHAT_ID=
ADMIN_TOKEN=

# BTCUSDC.P paper forward trading bot. This records simulated maker-limit trades only.
TRADING_TELEGRAM_CHAT_ID=
BTCUSDC_PAPER_SYMBOL=BTCUSDC
BTCUSDC_PAPER_DISPLAY_SYMBOL=BTCUSDC.P
BTCUSDC_PAPER_STATE_PATH=.phase1/btcusdc-paper-state.json
BTCUSDC_PAPER_LOG_PATH=.phase1/btcusdc-paper-events.jsonl
BTCUSDC_PAPER_INITIAL_EQUITY=1000
# Optional fixed-risk override. Leave blank to use daily-seed Kelly sizing.
BTCUSDC_PAPER_RISK_PCT=
BTCUSDC_PAPER_DAYS=3
BTCUSDC_PAPER_INTERVAL_MS=60000

# Fly.io / VPS realtime worker paths. Keep these on a persistent volume.
BTCUSDC_REALTIME_SYMBOL=BTCUSDC
BTCUSDC_REALTIME_DISPLAY_SYMBOL=BTCUSDC.P
BTCUSDC_REALTIME_INTERVAL=1m
BTCUSDC_REALTIME_CANDLES_PATH=/data/btcusdc-1m-candles.json
BTCUSDC_REALTIME_STATE_PATH=/data/btcusdc-paper-state.json
BTCUSDC_REALTIME_LOG_PATH=/data/btcusdc-paper-events.jsonl
BTCUSDC_REALTIME_WARMUP_CANDLES=6000
BTCUSDC_REALTIME_MAX_CANDLES=6000
BTCUSDC_REALTIME_RECONNECT_BASE_MS=1000
BTCUSDC_REALTIME_RECONNECT_MAX_MS=30000

# AI is paid only when explicitly needed for user questions or judgement.
AI_MODE=needed_only
AI_PROVIDER_PRIMARY=deepseek
AI_MODEL_PRIMARY=deepseek-v4-flash
AI_PROVIDER_JUDGE=anthropic
AI_MODEL_JUDGE=claude-sonnet-4-6
AI_JUDGE_MODE=important_only
AI_DAILY_LIMIT_KRW=3000
AI_MONTHLY_LIMIT_KRW=30000
OPENAI_MODEL=gpt-5.5
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
